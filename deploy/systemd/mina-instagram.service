[Unit]
Description=みなのInstagram承認済み4枠を配信
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mina-agent
Group=mina-agent
WorkingDirectory=/opt/marketing-agent
EnvironmentFile=/etc/marketing-agent/mina.env
EnvironmentFile=/etc/marketing-agent/doppler.env
EnvironmentFile=/etc/marketing-agent/instagram.env
ExecStart=/bin/sh /opt/marketing-agent/deploy/run-mina-instagram-doppler.sh daemon
Restart=on-failure
RestartSec=15
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/mina-agent
MemoryMax=512M
CPUQuota=100%

[Install]
WantedBy=multi-user.target
