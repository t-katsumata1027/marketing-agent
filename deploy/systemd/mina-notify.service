[Unit]
Description=翌日候補の20時承認依頼を準備

[Service]
Type=oneshot
User=mina-agent
Group=mina-agent
WorkingDirectory=/opt/marketing-agent
EnvironmentFile=/etc/marketing-agent/mina.env
ExecStart=/opt/marketing-agent/.venv-mina/bin/python -m src.mina notify
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mina-agent
