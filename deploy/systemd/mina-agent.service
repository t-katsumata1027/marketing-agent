[Unit]
Description=AI広報みなの検証用日次運用
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mina-agent
Group=mina-agent
WorkingDirectory=/opt/marketing-agent
EnvironmentFile=/etc/marketing-agent/mina.env
ExecStart=/opt/marketing-agent/.venv-mina/bin/python -m src.mina daemon
Restart=on-failure
RestartSec=15
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/mina-agent
MemoryMax=512M
CPUQuota=100%

[Install]
WantedBy=multi-user.target
