[Unit]
Description=既存X用データから翌日のInstagram投稿を準備
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=mina-agent
Group=mina-agent
WorkingDirectory=/opt/marketing-agent
EnvironmentFile=/etc/marketing-agent/mina.env
EnvironmentFile=/etc/marketing-agent/doppler.env
EnvironmentFile=/etc/marketing-agent/instagram.env
ExecStart=/bin/sh /opt/marketing-agent/deploy/run-mina-instagram-doppler.sh prepare-next
TimeoutStartSec=600
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/mina-agent
MemoryMax=512M
CPUQuota=100%
