# 値はサブPCの保護された設定ファイルまたはDopplerに保存する。
MINA_LIVE_WRITES=false
MINA_PUBLISH_ENABLED=false
MINA_APPROVAL_ENABLED=false
MINA_AI_ENABLED=false
MINA_PREPARE_ENABLED=false
MINA_READ_REVIEW_ENABLED=false
MINA_X_HISTORY_READ_ENABLED=false
MINA_HISTORY_AUTO_ENABLED=false
MINA_HISTORY_DIRECTORY=/var/lib/mina-agent/history
MINA_HISTORY_BOOTSTRAP=/var/lib/mina-agent/history-bootstrap.json
MINA_CUTOVER_FILE=/var/lib/mina-agent/cutover.json
MINA_SOURCE_COMMIT=
MINA_HISTORY_FILE=/var/lib/mina-agent/readiness.json
MINA_PREPARE_DIRECTORY=/var/lib/mina-agent/daily
MINA_AI_BACKEND=codex_cli
HOME=/var/lib/mina-agent
MINA_CODEX_BIN=/opt/marketing-agent/.codex-cli/node_modules/.bin/codex
MINA_CODEX_HOME=/var/lib/mina-agent/.codex
MINA_CODEX_WORKDIR=/var/lib/mina-agent/codex-jobs
MINA_DATABASE=/var/lib/mina-agent/mina.sqlite3
MINA_HEARTBEAT=/var/lib/mina-agent/mina.heartbeat
MINA_SHARE_HOST=
MINA_MEAL_API_BASE_URL=
MINA_AGENT_API_TOKEN=
MINA_DISCORD_APPLICATION_ID=
MINA_DISCORD_PUBLIC_KEY=
MINA_APPROVER_USER_IDS=
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_GUILD_ID=
DISCORD_ALLOWED_CHANNEL_ID=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# 新規X候補だけへ計測URLを固定する。既存承認済み候補は変更しない。
MINA_X_UTM_ENABLED=false

# v3救済は独立受入・配置・実行承認を別々に照合する。通常巡回から自動実行しない。
MINA_SCOPED_RESCUE_ENABLED=false
MINA_SCOPED_RESCUE_CONFIG=
