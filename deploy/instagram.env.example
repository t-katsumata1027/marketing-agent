# 初回の実画像・下書き検証とGateway対応後に、各項目を有効化する。
MINA_INSTAGRAM_DIRECTORY=/var/lib/mina-agent/instagram
MINA_INSTAGRAM_PREPARE_ENABLED=false
MINA_INSTAGRAM_NOTIFY_ENABLED=false
MINA_INSTAGRAM_APPROVAL_ENABLED=false
MINA_INSTAGRAM_PUBLISH_ENABLED=false
# 承認受付の設定は既存mina-gateway.serviceにも読み込ませる。
# MINA_DATABASEはXと同じ台帳を参照し、Buffer要求数を合算する。
